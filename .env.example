# ── Email delivery (quiz transactional emails + intake forms) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Development only. Prefer trusting your local proxy/antivirus CA instead.
SMTP_ALLOW_SELF_SIGNED_CERT=false

# Internal recipient for the administrative quiz summary and the separately
# acknowledged scheduling-help request. Visitor result emails go to the submitted
# email address instead. Optional; defaults to info@valisenmentalhealth.com.
QUIZ_LEAD_TO_EMAIL=
# Dedicated worksheet for persisted quiz submissions and engagement state.
# The API creates it if absent and only appends new schema columns to an exact
# known header prefix. Keep it separate from the general intake worksheet.
QUIZ_LEADS_SHEET_NAME=Quiz Leads
# HMAC secret used for opaque private-result/contact-help/PDF capability tokens.
# Generate a long random value for production. GOOGLE_PRIVATE_KEY is only a
# compatibility fallback.
QUIZ_LEAD_TOKEN_SECRET=
# Optional HTTPS base/template for the internal submission link in emails.
# Template example: https://admin.example.com/quiz/{referenceId}
QUIZ_LEAD_ADMIN_URL=
# Public origin used to build /quiz#result=... links in visitor emails.
# Supply an origin only (no path). Optional; defaults to the production site.
NEXT_PUBLIC_SITE_URL=https://valisenmentalhealth.com

# ── Cloudflare Turnstile (quiz, consultation + admin protection) ──
# Create a managed Turnstile widget restricted to the production hostname.
# The public site key renders the widget; the secret is server-only. Production
# fails closed if either is missing. Official always-pass test keys are used
# automatically only during local development/test.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostname allow-list. If omitted, the request host
# must match the hostname returned by Cloudflare Siteverify.
TURNSTILE_ALLOWED_HOSTNAMES=valisenmentalhealth.com,www.valisenmentalhealth.com

# Jane destinations are verified in lib/therapistBooking.ts, not environment
# variables. Every active therapist uses a verified Jane staff link. There is
# no Jane webhook/booking-confirmation secret because this site records
# outbound clicks, not confirmed bookings.
#
# Analytics continues to use the site's existing window.dataLayer/GTM integration.
# A privacy-limited first-party event stream also updates the four funnel
# worksheets below. It never accepts quiz answers, contact data, or free text.
# Campaign capture accepts only utm_source, utm_medium, utm_campaign, and
# utm_content; no separate analytics key or advertising click-ID setting exists.

# ── Google Sheets (general intake plus the separate quiz-leads worksheet) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Created automatically in GOOGLE_SHEET_ID when the first event arrives.
FUNNEL_SESSIONS_SHEET_NAME=Funnel Sessions
FUNNEL_EVENTS_SHEET_NAME=Funnel Events
FUNNEL_QUIZ_ATTEMPTS_SHEET_NAME=Quiz Attempts
FUNNEL_DASHBOARD_SHEET_NAME=Funnel Dashboard

# ── Per-therapist notification emails (general intake form only) ──
DAYONG_QUAN_EMAIL=
WILFRED_BENGNWI_EMAIL=
MERYEM_IBRAHIM_EMAIL=
TIM_KAHTAVA_EMAIL=
RYANN_SIMPSON_EMAIL=

# ── Mental Battery Checkpoints (server-only Supabase + private dashboard) ──
# Supabase project origin, for example https://your-project.supabase.co.
# Neither value is exposed to browser bundles. Run the committed SQL migration
# before assigning placements or collecting checkpoint events.
SUPABASE_URL=
# Prefer a current `sb_secret_...` server key. The legacy service-role JWT is
# supported only as a compatibility fallback through SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate all three values with:
#   node scripts/hash-checkpoint-admin-password.mjs
# The password hash uses PBKDF2-HMAC-SHA256. The session secret signs an
# eight-hour HttpOnly, Secure, SameSite=Strict admin cookie. The separate
# attribution repair secret signs short-lived, non-PII recovery capabilities.
CHECKPOINT_ADMIN_PASSWORD_HASH=
CHECKPOINT_ADMIN_SESSION_SECRET=
CHECKPOINT_ATTRIBUTION_REPAIR_SECRET=
