# ── Email delivery (required for all lead emails: quiz + intake forms) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Development only. Prefer trusting your local proxy/antivirus CA instead.
SMTP_ALLOW_SELF_SIGNED_CERT=false

# Where both internal quiz-results summaries and consented contact requests
# are delivered. The two emails have distinct subjects and consent language.
# Optional — defaults to info@valisenmentalhealth.com.
QUIZ_LEAD_TO_EMAIL=
# Dedicated worksheet for persisted quiz submissions. The API creates it if
# it does not exist. Keep this separate from the general intake worksheet.
QUIZ_LEADS_SHEET_NAME=Quiz Leads
# HMAC secret used to issue opaque contact-consent tokens. Generate a long,
# random value for production. GOOGLE_PRIVATE_KEY is a compatibility fallback.
QUIZ_LEAD_TOKEN_SECRET=
# Optional HTTPS base/template for the internal submission link in emails.
# Template example: https://admin.example.com/quiz/{referenceId}
QUIZ_LEAD_ADMIN_URL=

# ── Google Sheets (general intake plus the separate quiz-leads worksheet) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── Per-therapist notification emails (general intake form only) ──
DAYONG_QUAN_EMAIL=
WILFRED_BENGNWI_EMAIL=
TIM_KAHTAVA_EMAIL=
RYANN_SIMPSON_EMAIL=
